# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/onestop_sacco
DB_USERNAME=onestop
DB_PASSWORD=changeme

# ── JWT — generate a strong random Base64 secret (min 256 bits) ──────────────
# openssl rand -base64 64
JWT_SECRET=changeme-replace-with-a-long-random-base64-secret
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ── CORS — frontend origin(s) ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=OneStop

# ── Frontend → Backend ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api
